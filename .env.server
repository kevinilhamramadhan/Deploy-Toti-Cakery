# ═══════════════════════════════════════════════════════════════════════════
# Toti Cakery : .env untuk SERVER DEPLOY
#
# Di server perlu ada: docker-compose.yaml, .env ini, dan folder model/ yang
# berisi dua berkas konfigurasi model. Ketiganya didapat sekaligus dengan
# meng-clone repo deploy ini; tidak ada repo KODE yang perlu di-clone, sebab
# compose menarik image jadi dari GHCR.
#
# ═══════════════════════════════════════════════════════════════════════════

# ── ISI SENDIRI: jalan masuk dari internet (Cloudflare Tunnel) ─────────────
# Ketiga nilai ini dihasilkan SEKALI di laptop, bukan di server, dan TIDAK
# lewat dashboard Zero Trust (yang meminta kartu kredit walau tagihannya nol).
# Cukup akun Cloudflare biasa yang sudah memegang zone domainmu:
#
#   1. Pasang cloudflared di laptop, lalu:
#        cloudflared tunnel login          # pilih zone: web.id
#        cloudflared tunnel create toti    # catat UUID yang muncul
#        cloudflared tunnel route dns toti toticakery.web.id
#
#   2. Salin nilainya ke bawah ini:
#        TUNNEL_ID              = UUID dari langkah `create`
#        TUNNEL_CREDENTIALS_JSON= ISI berkas ~/.cloudflared/<UUID>.json,
#                                 dalam SATU baris. Ambil dengan:
#                                   tr -d '\n' < ~/.cloudflared/<UUID>.json
#        PUBLIC_HOSTNAME        = hostname yang tadi di-route
#
# `tunnel route dns` sendiri yang membuat CNAME-nya di Cloudflare. Jangan
# membuat A/AAAA record manual -- itu justru menabraknya.
TUNNEL_ID=
TUNNEL_CREDENTIALS_JSON=
PUBLIC_HOSTNAME=toticakery.web.id

# URL yang harus didaftarkan di dashboard Midtrans, ditulis di sini supaya
# tidak tercecer. Perhatikan prefiks /api: hanya jalur itu yang diproxy nginx
# ke backend. Tanpa /api, callback Midtrans mendarat di SPA fallback dan status
# pembayaran tidak pernah diperbarui.
#   https://toticakery.web.id/api/payments/notify

# ── ISI SENDIRI: rahasia ───────────────────────────────────────────────────
# Buat keenam nilai ini dengan:  openssl rand -hex 24
# (POSTGRES_PASSWORD wajib hex: nilainya disisipkan apa adanya ke dalam URL
#  koneksi, jadi karakter @ : / akan merusaknya.)
POSTGRES_PASSWORD=
SECRET_KEY=
SERVICE_API_KEY=
INTERNAL_API_KEY=
WEBHOOK_TOKEN=
WWEBJS_API_KEY=

# ── ISI SENDIRI: identitas toko ────────────────────────────────────────────
# Nomor WhatsApp chatbot -- yang dichat pelanggan, dan yang ditautkan lewat QR.
# WAJIB: backend memakainya untuk deep link verifikasi, dan menolak jalan
# dengan 503 bila kosong. Format 62, bukan 08.
CHATBOT_WA_NUMBER=
# Nomor admin penerima eskalasi TIDAK diisi di sini. Chatbot mengambilnya dari
# backend: user yang aktif dengan handles_takeover, lewat
# GET /api/admin/takeover-handlers. Kelola dari Admin Site supaya bisa diganti
# tanpa redeploy, dan supaya tidak ada dua sumber yang bisa berbeda isi.
# Nomor yang boleh minta laporan keuangan, dipisah koma. Format 628… juga.
# Kosong = tidak ada.
OWNER_WA_NUMBERS=
STORE_NAME=Toti Cakery
# Dipakai apa adanya di pesan "pesanan siap diambil".
STORE_ADDRESS=
# Alamat email tindak lanjut keluhan, disebut di balasan permintaan maaf.
# Kosong = balasannya tidak menyebut email sama sekali (bukan alamat karangan).
STORE_SUPPORT_EMAIL=

# ── Opsional: pembayaran ───────────────────────────────────────────────────
# Kosongkan kalau belum menguji pembayaran; /payments akan gagal, sisanya jalan.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Foto produk (Cloudinary) ───────────────────────────────────────────────
# Foto produk diunggah ke Cloudinary, bukan disimpan di server. Ketiga nilai
# diambil sekaligus dari Dashboard Cloudinary, bagian Product Environment
# Credentials. Pendaftarannya gratis dan tidak meminta kartu kredit.
#
# Boleh dikosongkan, tetapi konsekuensinya Admin Site tidak dapat mengunggah
# foto sama sekali: POST /products/{id}/image menolak dengan pesan
# "Konfigurasi Cloudinary belum lengkap di server backend." Bagian lain tetap
# berjalan normal.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Opsional: mengunci versi image ─────────────────────────────────────────
# Bawaannya :latest, dan `docker compose up -d` selalu menariknya. Jadi untuk
# naik versi tidak ada yang perlu diisi di sini -- cukup `up -d` lagi setelah
# CI-nya hijau.
#
# Yang perlu diisi justru kebalikannya: MENGUNCI ke versi tertentu, mis. saat
# rilis, atau saat perlu mundur karena versi terbaru bermasalah. CI ketiga repo
# menerbitkan tag sha-<commit> berdampingan dengan :latest, jadi versi lama
# selalu bisa dipanggil kembali:
#   BACKEND_IMAGE=ghcr.io/nicholl2/backend-cakery:sha-<commit>
#   FRONTEND_IMAGE=ghcr.io/azpdschool/toti-cakery-fe:sha-<commit>
#   CHATBOT_IMAGE=ghcr.io/kevinilhamramadhan/chatbot-cakery:sha-<commit>
# lalu: docker compose up -d

# ── Opsional: penyetelan ───────────────────────────────────────────────────
# Semuanya sudah punya nilai bawaan yang benar di docker-compose.yaml.
# Yang paling sering diubah cuma ini, saat RAM VPS mepet:
#   LLM_NUM_CTX=8192      # 32768 (bawaan) butuh ~5 GB hanya untuk LLM
